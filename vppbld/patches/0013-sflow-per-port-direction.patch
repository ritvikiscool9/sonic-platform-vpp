 }
 
+static inline u32
+sflow_direction_resolve(sflow_main_t *smp, sflow_per_interface_data_t *sfif)
+{
+  u32 effectiveD = sfif->direction ? sfif->direction : smp->samplingD;
+  return effectiveD;
+}
